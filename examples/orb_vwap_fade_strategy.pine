//@version=6
// ============================================================================
// ORB Breakout Fade — VWAP Reclaim Trigger
// ============================================================================
// Fades the first Opening Range Breakout of the session. Does NOT enter on the
// breakout itself — waits for a 1-min CLOSE back across session VWAP against
// the breakout direction, then fades toward the opposite side of the ORB.
// Stop sits at the breakout leg's extreme (new HOD/LOD made during the break),
// target is the opposite ORB boundary. Coded as a strategy() (backtestable),
// not an indicator().
//
// Assumptions / open items (see spec §9 — confirm before trusting results):
//   - Designed to run on the 1-minute chart. All logic below assumes 1-min bars.
//   - Works on both RTH-only and continuous (Globex) data: the "session" this
//     script resets on is defined by `vwapAnchorTime` (not the calendar date),
//     so a 09:30 anchor behaves like an RTH reset and an 18:00 anchor behaves
//     like a Globex/ETH reset. Set vwapAnchorTime accordingly for the data
//     you've loaded.
//   - Fill mechanics: calc_on_every_tick=false and process_orders_on_close=false
//     below, so an entry condition confirmed on bar N's close fills at bar
//     N+1's open (standard strategy.entry behavior). If you want the entry
//     modeled at the same bar's close instead, that requires enabling
//     calc_on_every_tick and reworking the trigger check — flagging this here
//     rather than silently picking one, per spec §8/§9, since it materially
//     changes backtest expectancy.
//   - stopBufferTicks is converted to price using syminfo.mintick, so confirm
//     the chart's symbol has the correct tick size for the instrument tested.
// ============================================================================

strategy(
     title                    = "ORB Breakout Fade — VWAP Reclaim",
     shorttitle               = "ORB-VWAP-Fade",
     overlay                  = true,
     // Bumped up from a smaller default: MNQ notional (~$2/pt * ~29,000 =
     // ~$58k/contract) can exceed a small initial_capital, which makes
     // TradingView's simulated margin check silently reject the fill —
     // strategy.entry() still runs (so the on-chart label still draws) but
     // no trade shows up in the Strategy Tester. Raise further if you're
     // testing an instrument with even larger notional per contract.
     initial_capital          = 100000,
     default_qty_type         = strategy.fixed,
     default_qty_value        = 1,
     pyramiding               = 0,
     calc_on_every_tick       = false,
     process_orders_on_close  = false,
     // commission_type / commission_value / slippage must ALL be compile-time
     // constants in Pine — strategy() rejects input.*() values for any of
     // them ("const float/int expected, input float/int used"). So these are
     // realistic defaults hardcoded here, not user-adjustable from the
     // Inputs tab. Edit the literals below directly for your instrument/
     // broker: commission_value is in $ per contract (cash_per_contract),
     // slippage is in ticks.
     commission_type          = strategy.commission.cash_per_contract,
     commission_value         = 2.5,
     slippage                 = 1)

// ── Inputs ───────────────────────────────────────────────────────────────
// Note: the `group` (and `title`/`tooltip`/`options`) argument of input.*()
// must be a literal string written directly in the call — Pine builds the
// Inputs UI panel via static analysis, so a variable there is a compile
// error. Hence the repeated literal group names below instead of a shared var.
i_orbStartTime   = input.string(defval = "0930", title = "ORB Start Time (HHMM, exchange time)", group = "Session & ORB")
i_orbDurationMin = input.int(defval = 5, title = "ORB Duration (minutes)", minval = 1, maxval = 120, group = "Session & ORB", tooltip = "Also test 15 as an alt config")
i_vwapAnchorSame = input.bool(defval = true, title = "VWAP Anchor Time = ORB Start Time", group = "Session & ORB")
i_vwapAnchorTime = input.string(defval = "0930", title = "VWAP Anchor Time (HHMM, used if above is false)", group = "Session & ORB")
i_sessionTZ      = input.string(defval = "America/New_York", title = "Session Time Zone", group = "Session & ORB")
i_sessionEndTime = input.string(defval = "1610", title = "Session End / Flatten Time (HHMM)", group = "Session & ORB")

i_oneTradePerSession = input.bool(defval = true, title = "One Trade Per Session", group = "Trade Rules")
i_stopBufferTicks    = input.float(defval = 0.0, title = "Stop Buffer (ticks beyond breakout extreme)", minval = 0.0, group = "Trade Rules")
i_enableLongFades    = input.bool(defval = true, title = "Enable Long Fades (fade DOWN breaks)", group = "Trade Rules")
i_enableShortFades   = input.bool(defval = true, title = "Enable Short Fades (fade UP breaks)", group = "Trade Rules")
i_qty                = input.int(defval = 1, title = "Contracts per Trade", minval = 1, group = "Trade Rules")

i_useDateFilter = input.bool(defval = false, title = "Limit Backtest to Date Range", group = "Date Range Filter")
// defval must be a const int (milliseconds since epoch, UTC) in v6 — timestamp()
// returns a runtime value there, so the range is hardcoded here instead:
// 1577836800000 = 2020-01-01 00:00 UTC, 4070908800000 = 2099-01-01 00:00 UTC.
i_startDate     = input.time(defval = 1577836800000, title = "Start", group = "Date Range Filter")
i_endDate       = input.time(defval = 4070908800000, title = "End", group = "Date Range Filter")

i_showDebugTable = input.bool(defval = true, title = "Show Debug Table", group = "Display")
i_showLabels     = input.bool(defval = true, title = "Show Break/Entry Labels", group = "Display")
i_showOrbShade   = input.bool(defval = true, title = "Shade ORB Window", group = "Display")

// ── Time helpers ─────────────────────────────────────────────────────────
// Session/anchor detection is done with plain hour()/minute()/calendar-date
// arithmetic rather than a dynamically-built time() session string. A
// time(timeframe, session, timezone) session argument that isn't a literal
// written directly in the call is not reliably evaluated as a real window —
// it can end up matching far more (or less) than intended, which is what
// caused ORB high/low to balloon out to some old historical level and the
// ORB window to never actually close (so no break/entry logic ever ran).
// This version avoids time()'s session matching entirely.
f_hhmmToMinutes(hhmm) =>
    h = int(str.tonumber(str.substring(hhmm, 0, 2)))
    m = int(str.tonumber(str.substring(hhmm, 2, 4)))
    h * 60 + m

f_dateId(t, tz) =>
    year(t, tz) * 10000 + month(t, tz) * 100 + dayofmonth(t, tz)

// ── Session windows built from inputs ───────────────────────────────────
orbStartMin    = f_hhmmToMinutes(i_orbStartTime)
orbEndMin      = orbStartMin + i_orbDurationMin

vwapAnchorHHMM = i_vwapAnchorSame ? i_orbStartTime : i_vwapAnchorTime
vwapAnchorMin  = f_hhmmToMinutes(vwapAnchorHHMM)

sessionEndMin   = f_hhmmToMinutes(i_sessionEndTime)
// If the flatten time's clock value is numerically before the anchor's
// (e.g. anchor 18:00, flatten 16:10), the flatten falls on the following
// calendar day — flag that so the threshold check below doesn't fire the
// instant the new session starts.
sessionEndWraps = sessionEndMin < vwapAnchorMin

barMinuteOfDay = hour(time, i_sessionTZ) * 60 + minute(time, i_sessionTZ)

inORBWindow = barMinuteOfDay >= orbStartMin and barMinuteOfDay < orbEndMin

// Bucket every bar into the session that most recently crossed the VWAP
// anchor time, using the bar's absolute calendar date (in sessionTimeZone)
// rather than a specific "anchor bar" — this is unaffected by data gaps,
// weekends, or a missing exact-minute bar at the anchor time.
sessionDateId = barMinuteOfDay >= vwapAnchorMin ? f_dateId(time, i_sessionTZ) : f_dateId(time - 86400000, i_sessionTZ)
newSession    = sessionDateId != sessionDateId[1]

pastSessionEnd = sessionEndWraps ?
     (barMinuteOfDay >= sessionEndMin and barMinuteOfDay < vwapAnchorMin) :
     (barMinuteOfDay >= sessionEndMin)

orbWindowStart = inORBWindow and not inORBWindow[1]
orbWindowEnd   = inORBWindow[1] and not inORBWindow

// ── Per-session state ───────────────────────────────────────────────────
var float orbHigh           = na
var float orbLow            = na
var bool  orbComplete       = false
var string breakDir         = na       // "UP", "DOWN", or na
var float breakoutExtreme   = na
var bool  triggered         = false
var bool  sessionSkipped    = false
var bool  tradedThisSession = false
var bool  flattenedThisSession = false
var float vwapCumPV         = 0.0
var float vwapCumVol        = 0.0
var float sessionVWAP       = na
var float stopLevel         = na
var float targetLevel       = na

if newSession
    tradedThisSession    := false
    flattenedThisSession := false
    sessionSkipped       := false
    breakDir             := na
    breakoutExtreme      := na
    triggered            := false
    stopLevel            := na
    targetLevel          := na
    vwapCumPV            := 0.0
    vwapCumVol           := 0.0
    sessionVWAP          := na
    orbHigh              := na
    orbLow               := na
    orbComplete          := false

if orbWindowStart
    orbHigh     := na
    orbLow      := na
    orbComplete := false

// ── ORB accumulation ────────────────────────────────────────────────────
if inORBWindow
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow  := na(orbLow) ? low : math.min(orbLow, low)

if orbWindowEnd
    orbComplete := true
    if (orbHigh - orbLow) <= 0
        sessionSkipped := true

// ── Session VWAP (typical price, running since the anchor bar) ─────────
tp = hlc3
vwapCumPV  += tp * volume
vwapCumVol += volume
sessionVWAP := vwapCumVol > 0 ? vwapCumPV / vwapCumVol : na

// ── End-of-session flatten (checked every bar, before new entries) ─────
if pastSessionEnd and not flattenedThisSession
    strategy.cancel_all()
    if strategy.position_size != 0
        strategy.close_all("Session Flatten")
    flattenedThisSession := true
    tradedThisSession    := true

// ── Date range filter ───────────────────────────────────────────────────
inDateRange = not i_useDateFilter or (time >= i_startDate and time <= i_endDate)

// ── Break detection + fade trigger ──────────────────────────────────────
canEvaluate = orbComplete and not inORBWindow and not sessionSkipped and
     not flattenedThisSession and inDateRange and
     not (i_oneTradePerSession and tradedThisSession)

if canEvaluate and na(breakDir)
    brokeUp   = high > orbHigh
    brokeDown = low < orbLow
    if brokeUp and brokeDown
        // Ambiguous — can't tell intrabar which boundary broke first. Skip.
        sessionSkipped := true
    else if brokeUp
        breakDir        := "UP"
        breakoutExtreme := high
        if i_showLabels
            label.new(bar_index, high, "BREAK ▲", style = label.style_label_down,
                 color = color.orange, textcolor = color.white, size = size.small)
    else if brokeDown
        breakDir        := "DOWN"
        breakoutExtreme := low
        if i_showLabels
            label.new(bar_index, low, "BREAK ▼", style = label.style_label_up,
                 color = color.orange, textcolor = color.white, size = size.small)

if canEvaluate and not na(breakDir) and not triggered
    breakoutExtreme := breakDir == "UP" ? math.max(breakoutExtreme, high) : math.min(breakoutExtreme, low)

    doLong  = breakDir == "DOWN" and i_enableLongFades and close > sessionVWAP
    doShort = breakDir == "UP" and i_enableShortFades and close < sessionVWAP

    if doShort
        stopLevel   := math.round_to_mintick(breakoutExtreme + i_stopBufferTicks * syminfo.mintick)
        targetLevel := orbLow
        strategy.entry("FadeShort", strategy.short, qty = i_qty)
        strategy.exit("FadeShortExit", "FadeShort", stop = stopLevel, limit = targetLevel)
        triggered         := true
        tradedThisSession := true
        if i_showLabels
            label.new(bar_index, high, "SHORT FADE", style = label.style_label_down,
                 color = color.red, textcolor = color.white, size = size.small)
    else if doLong
        stopLevel   := math.round_to_mintick(breakoutExtreme - i_stopBufferTicks * syminfo.mintick)
        targetLevel := orbHigh
        strategy.entry("FadeLong", strategy.long, qty = i_qty)
        strategy.exit("FadeLongExit", "FadeLong", stop = stopLevel, limit = targetLevel)
        triggered         := true
        tradedThisSession := true
        if i_showLabels
            label.new(bar_index, low, "LONG FADE", style = label.style_label_up,
                 color = color.green, textcolor = color.white, size = size.small)

// ── Plots ────────────────────────────────────────────────────────────────
plot(orbHigh, title = "ORB High", style = plot.style_linebr, color = color.new(color.teal, 0), linewidth = 1)
plot(orbLow, title = "ORB Low", style = plot.style_linebr, color = color.new(color.maroon, 0), linewidth = 1)
plot(sessionVWAP, title = "Session VWAP", color = color.new(color.blue, 0), linewidth = 1)
plot(strategy.position_size != 0 ? stopLevel : na, title = "Stop", style = plot.style_linebr, color = color.new(color.red, 0), linewidth = 1)
plot(strategy.position_size != 0 ? targetLevel : na, title = "Target", style = plot.style_linebr, color = color.new(color.green, 0), linewidth = 1)

bgcolor(i_showOrbShade and inORBWindow ? color.new(color.blue, 90) : na, title = "ORB Window")

if barstate.islast and timeframe.period != "1"
    label.new(bar_index, high, "⚠ Designed for the 1-minute chart", style = label.style_label_down,
         color = color.red, textcolor = color.white, size = size.normal)

// ── Debug table ──────────────────────────────────────────────────────────
var table dbg = table.new(position.top_right, 2, 8, border_width = 1, border_color = color.gray)
if i_showDebugTable and barstate.islast
    table.cell(dbg, 0, 0, "ORB VWAP Fade", text_color = color.white, bgcolor = color.new(color.gray, 60))
    table.cell(dbg, 1, 0, "", bgcolor = color.new(color.gray, 60))
    table.cell(dbg, 0, 1, "ORB High", text_color = color.white)
    table.cell(dbg, 1, 1, na(orbHigh) ? "—" : str.tostring(orbHigh, format.mintick), text_color = color.white)
    table.cell(dbg, 0, 2, "ORB Low", text_color = color.white)
    table.cell(dbg, 1, 2, na(orbLow) ? "—" : str.tostring(orbLow, format.mintick), text_color = color.white)
    table.cell(dbg, 0, 3, "Break Dir", text_color = color.white)
    table.cell(dbg, 1, 3, na(breakDir) ? "—" : breakDir, text_color = color.white)
    table.cell(dbg, 0, 4, "Breakout Extreme", text_color = color.white)
    table.cell(dbg, 1, 4, na(breakoutExtreme) ? "—" : str.tostring(breakoutExtreme, format.mintick), text_color = color.white)
    table.cell(dbg, 0, 5, "Session VWAP", text_color = color.white)
    table.cell(dbg, 1, 5, na(sessionVWAP) ? "—" : str.tostring(sessionVWAP, format.mintick), text_color = color.white)
    table.cell(dbg, 0, 6, "Session Skipped", text_color = color.white)
    table.cell(dbg, 1, 6, sessionSkipped ? "yes" : "no", text_color = color.white)
    table.cell(dbg, 0, 7, "Traded This Session", text_color = color.white)
    table.cell(dbg, 1, 7, tradedThisSession ? "yes" : "no", text_color = color.white)
